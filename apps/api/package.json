{
  "name": "@workboard/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm db:migrate && node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:database": "tsx --test test/database.integration.spec.ts",
    "test:session": "tsx --test test/session.integration.spec.ts",
    "test:reads": "tsx --test test/reads.integration.spec.ts",
    "test:access": "tsx --test test/access.integration.spec.ts",
    "test:grouping": "tsx --test test/grouping.integration.spec.ts"
  },
  "dependencies": {
    "@casl/ability": "7.1.1",
    "@casl/prisma": "2.2.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "8.3.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-fastify": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@querry-kit/nest": "workspace:*",
    "@workboard/contracts": "workspace:*",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "prisma": "7.10.1",
    "qs": "6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qs": "6.15.1",
    "@querry-kit/nuxt": "workspace:*",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
